# ============================================================
# PLATFOMNOU — varyab anviwònman (Vercel → Settings → Environment Variables)
# Gade DEPLOY.md pou eksplikasyon konplè.
# ============================================================

# ---------- OBLIGATWA ----------
# Upstash Redis (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Kle pou siyen sesyon yo — jenere: openssl rand -base64 32  (PA janm chanje l san rezon: dekonekte tout moun)
JWT_SECRET=
# Adrès piblik app la, ak https://, san "/" nan fen. Itilize nan lyen imèl yo.
APP_URL=https://non-ou.vercel.app
# Sekirize cron yo (backup + rapèl). Omwen 16 karaktè — jenere: openssl rand -base64 32
# San li, cron yo REFIZE tout demann (fail-closed).
CRON_SECRET=
# Imèl kont prensipal la (administratè sistèm lan). Mete l EKSPLISIT.
SUPER_ADMIN_EMAIL=

# ---------- 2FA ----------
# Kle pou chifre sekrè TOTP yo. Si vid, JWT_SECRET sèvi. Mete yon kle separe epi SOVE L (si w pèdi l, 2FA a dwe reaktive).
TOTP_ENCRYPTION_KEY=

# ---------- IMÈL "Mo de pas bliye" (chwazi YON opsyon) ----------
# Opsyon A — Gmail (gratis, san domèn). App Password 16 lèt: myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opsyon B — Resend (bezwen yon domèn verifye). Sèvi tou pou fakti ak mesaj kòmand yo.
RESEND_API_KEY=
SEND_DOMAIN=

# ---------- FOTO (rekòmande) ----------
# Vercel → Storage → Create → Blob (token an ajoute otomatikman). San li, foto yo rete nan Redis.
BLOB_READ_WRITE_TOKEN=

# ---------- OPSYONÈL ----------
NEXT_PUBLIC_SUPPORT_EMAIL=
# Push web: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ou@egzanp.com
# Sèlman app natif Android/iOS: kontni JSON kont sèvis Firebase (sou yon sèl liy)
FIREBASE_SERVICE_ACCOUNT=
# WhatsApp Cloud API (Meta)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_PLACED=
WHATSAPP_TEMPLATE_DELIVERED=
WHATSAPP_TEMPLATE_LANG=fr
