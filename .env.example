# Upstash Redis (créer une base sur https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clé secrète pour signer les sessions JWT — générer avec: openssl rand -base64 32
JWT_SECRET=

# Optionnel — envoi d'emails (factures)
RESEND_API_KEY=
SEND_DOMAIN=

# Optionnel — envoi WhatsApp (le lien wa.me ne nécessite pas de clé;
# une vraie intégration API Business nécessiterait ce token)
WHATSAPP_API_TOKEN=

# Sécurise la route /api/backup/cron appelée automatiquement par Vercel Cron
CRON_SECRET=

# Mobil (Capacitor) — URL piblik Vercel la, ak imèl sipò pou paj konfidansyalite
APP_URL=https://non-ou.vercel.app
NEXT_PUBLIC_SUPPORT_EMAIL=

# Notifikasyon push
# Jenere ak:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ou@egzanp.com
# Sèlman pou app natif Android/iOS: tout kontni fichye JSON kont sèvis Firebase la (sou yon sèl liy)
FIREBASE_SERVICE_ACCOUNT=

# Mesaj otomatik kòmand (WhatsApp Cloud API — Meta). Imèl yo itilize RESEND_API_KEY + SEND_DOMAIN.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_PLACED=
WHATSAPP_TEMPLATE_DELIVERED=
WHATSAPP_TEMPLATE_LANG=fr

# 2FA: kle pou chifre sekrè TOTP yo (opsyonèl; si vid, JWT_SECRET sèvi). Jenere: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
# APP_URL + RESEND_API_KEY + SEND_DOMAIN obligatwa pou imèl "Mo de pas bliye".

# Imèl "Mo de pas bliye" via Gmail (gratis, pa bezwen domèn):
# GMAIL_USER = adrès Gmail la; GMAIL_APP_PASSWORD = "App Password" 16 lèt (pa modpas Gmail ou)
GMAIL_USER=
GMAIL_APP_PASSWORD=
